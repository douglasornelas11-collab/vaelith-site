{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/login",
      "destination": "https://vaelith-platform-v5.vercel.app/login",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://vaelith-platform-v5.vercel.app/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?type=home"
    },
    {
      "source": "/noticias/:slug",
      "destination": "/api/page?type=article&slug=:slug"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/page?type=category&slug=:slug"
    },
    {
      "source": "/eventos",
      "destination": "/api/page?type=events"
    },
    {
      "source": "/eventos/:slug",
      "destination": "/api/page?type=event&slug=:slug"
    },
    {
      "source": "/sobre",
      "destination": "/api/page?type=about"
    },
    {
      "source": "/politica-editorial",
      "destination": "/api/page?type=editorial"
    },
    {
      "source": "/privacidade",
      "destination": "/api/page?type=privacy"
    },
    {
      "source": "/autor/douglas-ornelas",
      "destination": "/api/page?type=author"
    },
    {
      "source": "/buscar",
      "destination": "/api/page?type=search&q=:q"
    },
    {
      "source": "/analises/:slug",
      "destination": "/api/page?type=article&slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https://images.unsplash.com data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
